From c78c918da05297ff3f01827616c79e420fe168c9 Mon Sep 17 00:00:00 2001
From: RobertGarciaa <chae0218@naver.com>
Date: Sun, 18 Oct 2026 19:25:19 +0000
Subject: [PATCH 2/4] ActionReceiver: Inject RECEIVER_NOT_EXPORTED when running

Signed-off-by: RobertGarciaa <chae0218@naver.com>
---
 smali_classes8/com/oplus/aiunit/vision/rx.smali | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/smali_classes8/com/oplus/aiunit/vision/rx.smali b/smali_classes8/com/oplus/aiunit/vision/rx.smali
index 830840c..fabff44 100644
--- a/smali_classes8/com/oplus/aiunit/vision/rx.smali
+++ b/smali_classes8/com/oplus/aiunit/vision/rx.smali
@@ -125,6 +125,15 @@
     .line 15
     iget v6, v0, Lcom/oplus/aiunit/vision/tx;->c:I
 
+    # Preserve explicit export flags; default unflagged receivers to private.
+    and-int/lit8 v0, v6, 0x6
+
+    if-nez v0, :cond_export_flags_set
+
+    or-int/lit8 v6, v6, 0x4
+
+    :cond_export_flags_set
+
     .line 16
     invoke-virtual/range {v1 .. v6}, Landroid/content/Context;->registerReceiver(Landroid/content/BroadcastReceiver;Landroid/content/IntentFilter;Ljava/lang/String;Landroid/os/Handler;I)Landroid/content/Intent;
 
-- 
